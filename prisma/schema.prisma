// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  forms     Form[]

  @@map("users")
}

enum FormStatus {
  draft
  published
}

model Form {
  id            String     @id @default(cuid())
  userId        String
  title         String
  description   String?
  fieldsJson    Json       // Stores array of FormField according to FormSchema
  status        FormStatus @default(draft)
  botName       String     @default("FormAI Assistant")
  botGreeting   String?
  botPersona    String     @default("friendly") // friendly, professional, casual, formal
  knowledgeBase String?    // FAQs, business rules, return policies, context
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User?      @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  responses     Response[]

  @@index([userId])
  @@map("forms")
}

model Response {
  id          String   @id @default(cuid())
  formId      String
  dataJson    Json     // Key-value map of submitted form field answers
  sentiment   String?  // positive, neutral, negative
  leadScore   String?  // high, medium, low
  aiSummary   String?  // 1-sentence AI executive summary
  createdAt   DateTime @default(now())

  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("responses")
}
