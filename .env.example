# Database configuration
# When running with Docker Compose:
DATABASE_URL="postgresql://postgres:postgrespassword@db:5432/formai?schema=public"

# When running locally without Docker:
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/formai?schema=public"

# Clerk Authentication (Get keys at https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k
# Same value as above, WITHOUT the NEXT_PUBLIC_ prefix. Read at runtime, so
# auth works even when the platform doesn't pass build args (e.g. Dokploy).
CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k
CLERK_SECRET_KEY=sk_test_placeholder_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Anthropic Claude API Key (Required for AI form generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security
# DEMO_MODE=true allows unauthenticated access as a shared "demo_user"
# identity for Clerk-less local development. NEVER enable in production.
DEMO_MODE=false
# Secret key used to derive HMAC signatures for the quick webhook URL
# (X-FormAI-Signature header). Set to a long random string in production.
WEBHOOK_SIGNING_SECRET=change_me_to_a_long_random_string

# Admin Access Control (comma-separated list of Clerk user emails allowed to access /admin)
ADMIN_EMAILS=sugugalag@gmail.com

# File Uploads (S3 Stubbed / Mocked Interface)
S3_BUCKET_NAME=formai-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mock_access_key
S3_SECRET_ACCESS_KEY=mock_secret_key
